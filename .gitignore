# Node / Next.js app (see app/.gitignore for the authoritative app-level rules; this
# root .gitignore covers the repo root and anything git would otherwise see at top level)
app/node_modules/
app/.next/
app/out/
app/*.tsbuildinfo
app/next-env.d.ts
app/.env*
!app/.env.example

# Supabase CLI local state -- created wherever `supabase` is run (should
# always be app/, since app/supabase/migrations is the real project, but a
# misfire from the repo root creates a stray top-level supabase/.temp too).
supabase/.temp/
app/supabase/.temp/

.DS_Store
AEO_antigravity.code-workspace
