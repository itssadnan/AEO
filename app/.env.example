# Every env var the app needs. Copy this file to .env.local and fill in real values.
#
# Naming convention (established in Module 0.0, binding for every later module):
#   - NEXT_PUBLIC_ prefix = safe to ship to the browser. Reserved ONLY for values with
#     no security value if exposed (e.g. a public anon key that RLS already protects).
#   - No prefix = server-only. Never imported into client-bundled code. This is how
#     every service-role key, AI provider key, and payment secret in this file is stored.

# --- Supabase (Module 0.0 / 5.1) ---
# Create a project at https://supabase.com/dashboard, then Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key bypasses RLS — server-only, never sent to the browser.
# Used by admin-only routes (Module 5.10) and the ai_task_configs table (docs/CONVENTIONS.md Section 5).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (Module 5.3) ---
# Get a key at https://aistudio.google.com/apikey.
# Multi-key pool per docs/CONVENTIONS.md Section 5 (temporary, free-tier period only) —
# SECONDARY/TERTIARY are separate accounts belonging to other team members, not required to start.
GEMINI_API_KEY_PRIMARY=your-gemini-key
GEMINI_API_KEY_SECONDARY=
GEMINI_API_KEY_TERTIARY=
# Secret for the Supabase Edge Function scheduler. Store it as an Edge Function
# secret and in Supabase Vault; never expose it to a browser or Vercel.
ENGINE_WORKER_SECRET=replace-with-a-long-random-secret

# --- NVIDIA NIM (Module 5.4) ---
# Get a key at https://build.nvidia.com (NVIDIA Developer Program, free tier).
# Same multi-key pool pattern as Gemini above.
NVIDIA_NIM_API_KEY_PRIMARY=your-nvidia-nim-key
NVIDIA_NIM_API_KEY_SECONDARY=
NVIDIA_NIM_API_KEY_TERTIARY=
# Secret for the Supabase Edge Function extraction worker. Store it as an Edge Function
# secret and in Supabase Vault; never expose it to a browser or Vercel.
EXTRACTION_WORKER_SECRET=replace-with-a-long-random-secret
# Secret for the Supabase Edge Function scoring worker. Store it as an Edge Function
# secret and in Supabase Vault; never expose it to a browser or Vercel.
SCORING_WORKER_SECRET=replace-with-a-long-random-secret

# --- Razorpay (Module 5.9) ---
# Create a test-mode account at https://dashboard.razorpay.com.
# Left unset in this project as of 2026-07-31 -- every Server Action in
# modules/billing checks isRazorpayConfigured() first and returns a clean
# `{ error }` (no crash) when these are missing, same pattern as
# RESEND_API_KEY in Module 5.8.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# From Razorpay Dashboard > Settings > Webhooks, after creating the webhook endpoint
# (endpoint URL: https://<your-domain>/api/webhooks/razorpay).
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Create one Plan per paid tier in Razorpay Dashboard > Subscriptions > Plans
# (or via the Plans API) once the account exists, then paste each plan_id
# here. See modules/billing/plans.ts for the price/limits each tier should
# be created with.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_AGENCY=

# --- App ---
# Used for building absolute URLs (auth redirects, shareable free-check links, emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Alerting & Reporting (Module 5.8) ---
# Create a free-tier account at https://resend.com (3,000 emails/month free).
# Left unset in this project as of 2026-07-31 -- the alerting-worker Edge
# Function checks for this and cleanly skips sending (logs a warning, does not
# error or mark anything as sent) when it's not configured. Requires SPF/DKIM/
# DMARC records on the sending domain before real mail will deliver reliably
# (docs/CONVENTIONS.md Section 6).
RESEND_API_KEY=
# Must be an address on a domain verified with Resend once RESEND_API_KEY is set.
ALERTING_FROM_EMAIL=AEO Visibility <alerts@your-verified-domain.com>
# Secret for the Supabase Edge Function alerting worker. Store it as an Edge
# Function secret and in Supabase Vault; never expose it to a browser or Vercel.
ALERTING_WORKER_SECRET=replace-with-a-long-random-secret

# --- Crawl-Readiness Audit (Module 5.7) ---
# Optional — has a sensible default in code (app/src/modules/crawl-audit/fetchers.ts).
# Only set this if you want to identify the crawler with a different UA string
# (e.g. once a real product domain is finalized).
CRAWL_AUDIT_USER_AGENT=

# --- Admin / Ops Console (Module 5.10) ---
# Comma-separated list of normalized founder/admin email addresses allowed to access /admin.
# Server-only, never NEXT_PUBLIC_. Empty list denies access to everyone.
ADMIN_USER_EMAILS=
# Optional Slack/Discord incoming webhook URL for immediate alerts when an API key is marked dead.
ADMIN_ALERT_WEBHOOK_URL=